// Reglas de seguridad de Firestore para RetroRocket
// Copia estas reglas en la consola de Firebase > Firestore Database > Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Feature 017 (backend-mediated Firebase access): every collection below is now
    // read and written exclusively by the backend's Admin SDK, which bypasses these
    // rules by design. The rules are explicit denies, not grants — no client
    // (authenticated or not) may read or write any of them directly anymore. This
    // replaces the previous global catch-all (`allow read, write: if
    // request.auth != null && ... != 'anonymous'`), which — combined with the
    // per-collection grants below it — let any authenticated non-anonymous user read
    // or write every document in the database directly via the client SDK,
    // including another facilitator's private notes (research.md §2's dead-rule
    // finding: the facilitator-only checks on `facilitatorNotes` never actually
    // mattered, because the top-level catch-all already granted blanket access
    // first). Mirrors the existing `mcpClients`/`mcpAuthorizationCodes`/
    // `mcpConnections` deny-all pattern (feature 015).
    match /retrospectives/{retrospectiveId} {
      allow read, write: if false;

      match /columns/{columnId} {
        allow read, write: if false;
      }

      // Legacy path from before cards moved to a top-level collection — denied for
      // the same reason as everything else here.
      match /cards/{cardId} {
        allow read, write: if false;
      }
    }

    match /cards/{cardId} {
      allow read, write: if false;
    }

    match /groups/{groupId} {
      allow read, write: if false;
    }

    match /participants/{participantId} {
      allow read, write: if false;
    }

    match /typingStatus/{typingId} {
      allow read, write: if false;
    }

    match /countdown_timers/{retrospectiveId} {
      allow read, write: if false;
    }

    match /facilitatorNotes/{noteId} {
      allow read, write: if false;
    }

    match /sentimentResults/{resultId} {
      allow read, write: if false;
    }

    match /actionItems/{actionItemId} {
      allow read, write: if false;
    }

    // No longer written by the frontend at all (superseded by Firebase Auth custom
    // claims, US1) — denied for defense-in-depth even though nothing currently
    // populates these collections.
    match /users/{userId} {
      allow read, write: if false;
    }

    match /userBoardHistory/{historyId} {
      allow read, write: if false;
    }

    // MCP connector state (feature 015): these three collections are read and written
    // exclusively by the backend's Admin SDK, which bypasses these rules by design.
    // The rules below are explicit denies, not grants — no client (authenticated or
    // not) may read or write them directly, since they carry authorization state
    // (connection status, authorization codes) that must only ever be mutated through
    // the backend's own live-revocation-checked logic (Clarification 2026-07-27 Q1).
    match /mcpClients/{clientId} {
      allow read, write: if false;
    }

    match /mcpAuthorizationCodes/{code} {
      allow read, write: if false;
    }

    match /mcpConnections/{connectionId} {
      allow read, write: if false;
    }

    // Default deny for anything not explicitly listed above (replaces the previous
    // global catch-all grant).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

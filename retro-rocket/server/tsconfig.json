{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vitest/globals"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@server/*": ["./src/*"],
      // 056-team-metrics-dashboard: type-resolution only, for server/test's parity
      // fixtures that assert the server-side mood-scoring duplicates (src/domain/teams/
      // {isConfident,moodScore}.ts) match the frontend originals they mirror
      // (research.md item 5/8). Production code under server/src/domain/ must never use
      // this alias — the whole point of the duplicates is to avoid a real cross-project
      // dependency; only server/test/**/*.test.ts parity checks should ever import
      // through it.
      "@/*": ["../src/*"]
    }
  },
  "include": ["src", "test", "../api"]
}

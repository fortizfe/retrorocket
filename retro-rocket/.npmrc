# Make dependency installs resilient to transient registry network blips
# (e.g. ECONNRESET / "network aborted" on CI runners) by retrying with backoff
# instead of failing the job on the first hiccup.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=600000

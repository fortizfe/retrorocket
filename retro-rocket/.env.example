# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Environment
NODE_ENV=development

# ── Backend (server/ + api/) environment ─────────────────────────────────────
# SERVER-ONLY secrets. Never prefix with VITE_ (that ships them to the browser).
# Set them in Vercel Project Settings for deployments.

# App session (signed JWT) — signs/verifies the httpOnly session cookie.
SESSION_SIGNING_KEY=

# OAuth provider credentials (backend-orchestrated OAuth).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Base URL providers redirect back to (no trailing slash). Local dev: http://localhost:3000
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# Firebase Admin credentials for identity store + custom-token minting
# (stringified service-account JSON, or rely on emulator settings).
FIREBASE_SERVICE_ACCOUNT=

# Emulator/E2E only — mounts the guarded /api/auth/test-login route.
# MUST be unset (or false) in production.
AUTH_TEST_MODE=false

# Optional: backend version surfaced by /api/health.
BACKEND_VERSION=dev

# Local dev backend port (Vite proxies /api → this).
SERVER_PORT=3001
